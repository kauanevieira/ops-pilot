OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Modelo reserva, usado quando o principal falha (opcional).
OPENROUTER_MODEL_FALLBACK=

# Preço de entrada por modelo, em USD por 1 milhão de tokens, para o custo de GET /stats
# (opcional). Modelos ":free" custam 0 sem precisar estar aqui. Ex.:
# OPENROUTER_PRICES={"openai/gpt-4o-mini": 0.15}
OPENROUTER_PRICES=

# Caminho do arquivo SQLite (default: ./data/opspilot.db). Os testes usam ":memory:".
OPSPILOT_DB=

# Origens que o navegador pode usar para chamar a API (CORS), separadas por vírgula (opcional).
# Padrão: http://localhost:5173, o servidor de desenvolvimento da war room. A preview do build
# (npm --prefix web run preview) roda em 4173 e precisa entrar na lista. Ex.:
# OPSPILOT_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://kauane.dev
OPSPILOT_CORS_ORIGINS=
